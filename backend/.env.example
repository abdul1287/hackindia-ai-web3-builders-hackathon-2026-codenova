# Database Configuration
# PostgreSQL (Production / Standard):
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/civicai
# SQLite (Local Dev / Offline Demo):
DATABASE_URL=sqlite:///./civicai.db

# LLM API Configuration (Multimodal Vision API - Gemini or OpenAI Compatible)
LLM_API_KEY=
LLM_MODEL=gemini-1.5-flash
LLM_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Cloudinary Storage Configuration
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# CORS Origins (Comma-separated list of allowed origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Application Settings
ENVIRONMENT=development
API_V1_STR=/api
MAX_IMAGE_SIZE_MB=10
